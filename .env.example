# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API). Obrigatório: sem estas variáveis o app não inicia em
# desenvolvimento. Nos builds do EAS, cadastre-as em expo.dev → Environment variables.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# A chave do Gemini NÃO vai aqui (tudo que começa com EXPO_PUBLIC_ fica dentro do app).
# Ela é um segredo da Edge Function:
#   supabase secrets set GEMINI_API_KEY=sua-chave
